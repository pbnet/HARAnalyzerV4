<Window x:Class="HARAnalyzerV4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HAR Analyzer V4"
        Icon="pack://application:,,,/HARIco.ico"
        Height="850"
        Width="1450"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="#F3F3F3"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1"
                Padding="9">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">

                    <Button x:Name="OpenHarButton"
                            Content="Open HAR"
                            Width="100"
                            Height="32"
                            Margin="0,0,10,0"
                            ToolTip="Open a HAR file"
                            Click="OpenHar_Click"/>

                    <Button x:Name="ConvertSazButton"
                            Content="SAZ → HAR"
                            Width="110"
                            Height="32"
                            Margin="0,0,10,0"
                            ToolTip="Convert a Fiddler SAZ file to HAR"
                            Click="ConvertSaz_Click"/>

                    <Button x:Name="ZipHarButton"
                            Content="Zip HAR"
                            Width="100"
                            Height="32"
                            Margin="0,0,10,0"
                            ToolTip="Compress the current HAR file to ZIP"
                            Click="ZipHar_Click"/>

                    <Button x:Name="SaveSelectedHarButton"
                            Content="Save selected HAR"
                            Width="145"
                            Height="32"
                            Margin="0,0,10,0"
                            IsEnabled="False"
                            ToolTip="Select frames with Ctrl+click or Shift+click, then save them to a new HAR file."
                            Click="SaveSelectedHar_Click"/>

                    <Button x:Name="AboutButton"
                            Content="About"
                            Width="100"
                            Height="32"
                            ToolTip="About HAR Analyzer V4"
                            Click="About_Click"/>
                </StackPanel>

                <TextBox x:Name="SearchBox"
                         Grid.Column="2"
                         Height="32"
                         Margin="0,0,8,0"
                         Padding="6,4"
                         VerticalContentAlignment="Center"
                         ToolTip="Search frame / URL / host / method / status"
                         TextChanged="SearchBox_TextChanged"/>

                <Button x:Name="ClearSearchButton"
                        Grid.Column="3"
                        Content="X"
                        Width="32"
                        Height="32"
                        Margin="0,0,10,0"
                        ToolTip="Clear search"
                        Click="ClearSearch_Click"/>

                <TextBlock Grid.Column="4"
                           Text="Search"
                           VerticalAlignment="Center"
                           Foreground="#555555"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1"
              Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- Frame list -->
            <DataGrid x:Name="HarGrid"
                      Grid.Row="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#FAFAFA"
                      ToolTip="Ctrl+click: individual frames. Shift+click: range. Ctrl+A: all visible frames."
                      SelectionChanged="HarGrid_SelectionChanged">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="#"
                                        Binding="{Binding FrameNumber}"
                                        Width="55"/>

                    <DataGridTextColumn Header="Result"
                                        Binding="{Binding Status}"
                                        Width="70"/>

                    <DataGridTextColumn Header="Method"
                                        Binding="{Binding Method}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Protocol"
                                        Binding="{Binding Protocol}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Host"
                                        Binding="{Binding Host}"
                                        Width="220"/>

                    <DataGridTextColumn Header="URL"
                                        Binding="{Binding Url}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Body"
                                        Binding="{Binding BodySize}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Content-Type"
                                        Binding="{Binding ContentType}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Time"
                                        Binding="{Binding Time}"
                                        Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#CCCCCC"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Frame details -->
            <TabControl Grid.Row="2">

                <TabItem Header="Request">
                    <TextBox x:Name="RequestText"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             Background="White"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </TabItem>

                <TabItem Header="Response">
                    <TextBox x:Name="ResponseText"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             Background="White"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </TabItem>

                <TabItem Header="Body">
                    <TextBox x:Name="BodyText"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             Background="White"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </TabItem>

                <TabItem Header="Statistics">
                    <TextBox x:Name="StatisticsText"
                             Margin="5"
                             BorderThickness="0"
                             Background="White"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </TabItem>

                <TabItem Header="Timeline">
                    <Grid Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#F7F7F7"
                                BorderBrush="#CCCCCC"
                                BorderThickness="0,0,0,1">

                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TimelineTitle"
                                           Grid.Column="0"
                                           Text="Session Timeline"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>

                                <TextBlock x:Name="TimelineSummary"
                                           Grid.Column="1"
                                           Foreground="#666666"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">

                            <Canvas x:Name="TimelineCanvas"
                                    Background="White"
                                    MinHeight="250"
                                    MinWidth="900"
                                    SizeChanged="TimelineCanvas_SizeChanged"/>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText"
                           Text="Ready"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <TextBlock x:Name="FrameCountText"
                           Text="Frames: 0"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <TextBlock x:Name="VisibleFrameCountText"
                           Text="Visible: 0"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <TextBlock x:Name="SelectedFrameText"
                           Text="Selected: none"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>